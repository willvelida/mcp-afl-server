<!-- Azure API Management Policy for MCP Server
    Handles authentication and operation-specific caching -->
<policies>
    <inbound>
        <base />
        
        <!-- Validate Azure AD JWT Token (skip for mcp-prm) -->
        <validate-azure-ad-token tenant-id="{{McpTenantId}}" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized">
            <audiences>
                <audience>{{McpClientId}}</audience>
            </audiences>
         </validate-azure-ad-token>


        <!-- Single cache lookup - only for cacheable operations -->
        <choose>
            <when condition="@(context.Operation.Name == &quot;mcp-health-check&quot; || context.Operation.Name == &quot;mcp-streamable-get&quot;)">
                <cache-lookup vary-by-developer="false" vary-by-developer-groups="false" caching-type="internal">
                    <vary-by-header>Authorization</vary-by-header>
                    <vary-by-query-parameter>*</vary-by-query-parameter>
                </cache-lookup>
            </when>
        </choose>
        
        <!-- Set cache control headers based on operation -->
        <set-header name="Cache-Control" exists-action="override">
            <value>@{
                string operationName = context.Operation.Name;
                switch (operationName) {
                    case "mcp-health-check":
                        return "public, max-age=30";
                    case "mcp-streamable-get":
                        return "public, max-age=300";
                    case "mcp-sse":
                    case "mcp-message":
                    case "mcp-streamable-post":
                        return "no-cache, no-store, must-revalidate";
                    default:
                        return "public, max-age=60";
                }
            }</value>
        </set-header>

        <!-- Debug header -->
        <set-header name="X-Operation-Name" exists-action="override">
            <value>@(context.Operation.Name)</value>
        </set-header>
    </inbound>
    
    <backend>
        <base />
    </backend>
    
    <outbound>
        <base />
        
        <!-- Single cache store - only for successful cacheable operations -->
        <choose>
            <when condition="@(context.Response.StatusCode == 200 &amp;&amp; (context.Operation.Name == &quot;mcp-health-check&quot; || context.Operation.Name == &quot;mcp-streamable-get&quot;))">
                <cache-store caching-type="internal">
                    <duration>@{
                        string operationName = context.Operation.Name;
                        if (operationName == "mcp-health-check") {
                            return 30;
                        } else if (operationName == "mcp-streamable-get") {
                            return 300;
                        }
                        return 60;
                    }</duration>
                </cache-store>
            </when>
        </choose>
        
        <!-- Add monitoring headers -->
        <set-header name="X-Cache-Status" exists-action="override">
            <value>@(context.Variables.ContainsKey("cachedResponse") ? "HIT" : "MISS")</value>
        </set-header>
        
        <set-header name="X-Response-Time" exists-action="override">
            <value>@(context.Elapsed.TotalMilliseconds.ToString() + "ms")</value>
        </set-header>
    </outbound>
    
    <on-error>
        <base />
        <choose>
            <when condition="@(context.Response.StatusCode == 401)">
                <return-response>
                    <set-status code="401" reason="Unauthorized" />
                    <set-header name="WWW-Authenticate" exists-action="override">
                        <value>Bearer error="invalid_token", resource_metadata="{{APIMGatewayURL}}/mcp/prm"</value>
                    </set-header>
                </return-response>
            </when>
        </choose>
    </on-error>
</policies>