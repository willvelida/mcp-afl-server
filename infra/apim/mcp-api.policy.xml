<!--
    Azure API Management Policy for MCP Server
    Handles authentication and operation-specific caching for MCP endpoints
-->
<policies>
    <inbound>
        <base />
        <!-- Validate Azure AD JWT Token -->
        <validate-azure-ad-token tenant-id="{{McpTenantId}}" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized">
            <audiences>
                <audience>{{McpClientId}}</audience>
            </audiences>
        </validate-azure-ad-token>

        <!-- Operation-specific cache lookup -->
        <choose>
            <!-- Health check - cache for 30 seconds -->
            <when condition="@(context.Operation.Name.Equals("mcp-health-check"))">
                <cache-lookup vary-by-developer="false" 
                             vary-by-developer-groups="false" 
                             downstream-caching-type="none" 
                             must-revalidate="true" 
                             caching-type="internal">
                    <vary-by-header>Accept</vary-by-header>
                </cache-lookup>
            </when>
            
            <!-- Streamable GET - cache for 5 minutes -->
            <when condition="@(context.Operation.Name.Equals("mcp-streamable-get"))">
                <cache-lookup vary-by-developer="false" 
                             vary-by-developer-groups="false" 
                             downstream-caching-type="none" 
                             must-revalidate="true" 
                             caching-type="internal">
                    <vary-by-header>Accept</vary-by-header>
                    <vary-by-header>Authorization</vary-by-header>
                    <vary-by-query-parameter>*</vary-by-query-parameter>
                </cache-lookup>
            </when>
        </choose>
        
        <!-- Operation-specific cache control headers -->
        <set-header name="Cache-Control" exists-action="override">
            <value>@{
                string operationName = context.Operation.Name;
                if (operationName == "mcp-health-check") {
                    return "public, max-age=30";
                } else if (operationName == "mcp-streamable-get") {
                    return "public, max-age=300, stale-while-revalidate=60";
                } else if (operationName == "mcp-sse") {
                    return "no-cache, no-store, must-revalidate";
                } else if (operationName == "mcp-message" || operationName == "mcp-streamable-post") {
                    return "no-cache, no-store, must-revalidate";
                } else {
                    return "public, max-age=60";
                }
            }</value>
        </set-header>

        <!-- Add operation context for debugging -->
        <set-header name="X-Operation-Name" exists-action="override">
            <value>@(context.Operation.Name)</value>
        </set-header>
    </inbound>
    
    <backend>
        <base />
    </backend>
    
    <outbound>
        <base />
        
        <!-- Operation-specific cache storage -->
        <choose>
            <when condition="@(context.Response.StatusCode == 200)">
                <choose>
                    <!-- Health check - 30 seconds -->
                    <when condition="@(context.Operation.Name.Equals("mcp-health-check"))">
                        <cache-store duration="30" caching-type="internal" />
                    </when>
                    
                    <!-- Streamable GET - 5 minutes -->
                    <when condition="@(context.Operation.Name.Equals("mcp-streamable-get"))">
                        <cache-store duration="300" caching-type="internal" />
                    </when>
                    
                    <!-- Don't cache SSE, POST operations, or real-time endpoints -->
                </choose>
            </when>
        </choose>
        
        <!-- Add debugging and monitoring headers -->
        <set-header name="X-Cache-Status" exists-action="override">
            <value>@(context.Variables.ContainsKey("cache-hit") ? "HIT" : "MISS")</value>
        </set-header>
        
        <set-header name="X-Cache-Key" exists-action="override">
            <value>@(context.Variables.GetValueOrDefault("cache-key", "none").ToString())</value>
        </set-header>
        
        <set-header name="X-Response-Time" exists-action="override">
            <value>@(context.Elapsed.TotalMilliseconds.ToString() + "ms")</value>
        </set-header>
        
        <!-- Add MCP-specific headers -->
        <set-header name="X-MCP-Server" exists-action="override">
            <value>AFL-MCP-Server</value>
        </set-header>
    </outbound>
    
    <on-error>
        <base />
        <choose>
            <when condition="@(context.Response.StatusCode == 401)">
                <return-response>
                    <set-status code="401" reason="Unauthorized" />
                    <set-header name="WWW-Authenticate" exists-action="override">
                        <value>Bearer error="invalid_token", resource_metadata="{{APIMGatewayURL}}/mcp/prm"</value>
                    </set-header>
                </return-response>
            </when>
        </choose>
    </on-error>
</policies>